# Build outputs
dist
.output
.vinxi
.vercel
.netlify
.wrangler
app.config.timestamp_*.js

# Environment
.env
.env*.local

# Dependencies
node_modules

# TypeScript
*.tsbuildinfo

# Testing
coverage
test-results
playwright-report
.playwright-mcp

# Logs
*.log

# IDEs and editors
.idea
.vscode/*
!.vscode/extensions.json

# Editor backups
*.swp
*.swo
*~
*.bak

# System files
.DS_Store
Thumbs.db
Desktop.ini

# MCP (machine-local — provisioned by workspace setup / Nucleo Studio)
.mcp.json

# CDN-first asset working dir — only the lockfile and registry.ts are
# committed (see assets/README.md).
assets/src/*
!assets/src/.gitkeep

# `wolf-dev assets hydrate` output: build input for a frozen bundle, pulled
# from the CDN on demand.
public/assets/cdn/

# Cortex-managed symlinks and generated docs (regenerated by postinstall via @wolfgames/cortex/scripts/setup.mjs).
# Keep local/ tracked — it's the project-only source of truth for rules and skills.
.agents/rules/
.agents/skills/
.agents/commands/
.claude/rules/
.claude/skills/
.claude/commands/
.claude/hooks/
.claude/rules.md
docs/cortex-inventory.md

# Cursor support is deprecated — cortex 0.5.0 reroutes generated scaffolding to .agents/ and .claude/.
.cursor/

# Cache
.cache
.eslintcache

# Stryker mutation-testing scratch sandbox (tier-a/reports/mutation.json is the kept artifact)
.stryker-tmp/

# tier-a phase transcripts stay local (gate Q3 reads them from disk)
tier-a/run-*/transcripts/
